{
  "name": "portlease",
  "version": "0.2.1",
  "description": "Unique dev ports per directory, from a machine-wide registry, written into your .env",
  "license": "MIT",
  "keywords": [
    "ports",
    "port-allocation",
    "dev-server",
    "env",
    "git-worktree",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://github.com/desclapez/portlease#readme",
  "bugs": {
    "url": "https://github.com/desclapez/portlease/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desclapez/portlease.git"
  },
  "bin": {
    "portlease": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"src/**/*.test.ts\"",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
